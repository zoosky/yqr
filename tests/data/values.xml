  office.localEnv.EDA_IMPORT_CRON_SCHEDULE: '1-19\,21-39\,41-59 * * * *'
  office.localEnv.EDA_IMPORT_HEALING_ENABLED: "true"
  office.localEnv.EDA_IMPORT_HEALING_DRY_RUN: "false"
  office.localEnv.EDA_IMPORT_HEALING_CRON_SCHEDULE: '0\,20\,40 * * * *'
  office.localEnv.EDA_IMPORT_LOCK_TTL_MILLISECONDS: "120000"
  office.localEnv.EDA_IMPORT_MASTER_REFERRER: "xr-office"

preOfficeCountry_helmExtraSets: &preOfficeCountry_helmExtraSets
