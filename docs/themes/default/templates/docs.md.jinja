{# Documentation markdown template (Feature f109).
   Renders docs pages in markdown format with TOC and navigation. #}
{% extends "base.md.jinja" %}

{% block body %}
# {{ page.title }}

{% if page.toc %}
## Table of Contents

{% for entry in page.toc %}
{{ "  " * (entry.level - 1) }}- [{{ entry.text }}](#{{ entry.id }})
{% endfor %}

---
{% endif %}

{{ page.content }}

{% if page.children %}

## In this section

{% for child in page.children %}
- [{{ child.title }}]({{ child.url }}){% if child.lead %} - {{ child.lead }}{% endif %}

{% endfor %}
{% endif %}

{% if page.prev or page.next %}
---

{% if page.prev %}Previous: [{{ page.prev.title }}]({{ page.prev.url }}){% endif %}
{% if page.prev and page.next %} | {% endif %}
{% if page.next %}Next: [{{ page.next.title }}]({{ page.next.url }}){% endif %}
{% endif %}
{% endblock %}
