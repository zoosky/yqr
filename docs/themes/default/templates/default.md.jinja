{# Default markdown page template (Feature f109).
   Renders a standard content page in markdown format. #}
{% extends "base.md.jinja" %}

{% block body %}
# {{ page.title }}

{% if page.date or page.author or page.reading_time %}
*{% if page.date %}{{ page.date }}{% endif %}{% if page.author %} | by {{ page.author }}{% endif %}{% if page.reading_time %} | {{ page.reading_time }} min read{% endif %}*
{% endif %}

{{ page.content }}

{% if page.tags %}
**Tags:** {% for tag in page.tags %}[{{ tag }}](/tags/{{ tag }}){% if not loop.last %}, {% endif %}{% endfor %}
{% endif %}

{% if page.prev or page.next %}
---

{% if page.prev %}Previous: [{{ page.prev.title }}]({{ page.prev.url }}){% endif %}
{% if page.prev and page.next %} | {% endif %}
{% if page.next %}Next: [{{ page.next.title }}]({{ page.next.url }}){% endif %}
{% endif %}
{% endblock %}
