<!DOCTYPE html>
<html lang="{{ page.language or site.current_language or site.language }}" dir="{{ page.direction or 'ltr' }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ page.title }} - {{ site.name }}{% endblock %}</title>
    {# Social-sharing + SEO head metadata: page-specific description, build-safe
       canonical, Open Graph, Twitter Cards, hreflang, and the open meta map. #}
    {% include "partials/head_meta.html.jinja" %}
    <link rel="icon" type="image/svg+xml" href="{{ url('/theme/assets/favicon.svg') }}">
    <meta name="theme-color" content="#0b1524">
    {# Canonical now emitted by partials/head_meta.html.jinja (build-safe). #}
    {# Feature f082: cdn_url() rewrites asset paths to the configured CDN origin
       when CDN integration is enabled (Pro), and returns the path unchanged
       otherwise -- so this works on every edition. #}
    {% for css in theme.assets.css %}
    <link rel="stylesheet" href="{{ cdn_url('/' ~ (('theme/assets/' ~ css) | fingerprint)) }}">
    {% endfor %}
    {# Feature f082: to serve Google Fonts privately through the CMS origin
       (no visitor IP leak), enable cdn.font_proxy and link them via:
       <link rel="stylesheet" href="{{ font_css_url('Inter:wght@400;700') }}"> #}
    {# yqr type system (from docs/content/home.html): Georgia serif display,
       system sans body, JetBrains Mono code. Only the mono face is a
       webfont; serif and sans resolve locally. #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet">
    {% if theme.styling is defined and theme.styling.tailwind_cdn %}
    <script src="https://cdn.tailwindcss.com"></script>
    {% if theme.styling.tailwind_config %}
    <script>tailwind.config = {{ theme.styling.tailwind_config | safe }};</script>
    {% endif %}
    {% endif %}
    {% set analytics_id = get_env(name="ACCENT_ANALYTICS_ID") %}
    {% if analytics_id %}
    <script async src="https://www.googletagmanager.com/gtag/js?id={{ analytics_id }}"></script>
    {% endif %}
    {% if site.url %}
    {% if page.language and page.language != site.language %}
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} RSS Feed ({{ page.language | upper }})"
        href="{{ absolute_url('/' ~ page.language ~ '/feed.xml') }}">
    {% else %}
    <link rel="alternate" type="application/rss+xml" title="{{ site.name }} RSS Feed" href="{{ absolute_url('/feed.xml') }}">
    {% endif %}
    {% endif %}
    {# Feature f121: the LLM-crawler discovery `<link rel="alternate" href="/llms.txt">` is auto-injected by the template engine. #}
    <meta name="build-hash" content="{{ get_hash(literal=accent.version ~ accent.git_hash) }}">
    {# Conditional KaTeX loading for pages with math expressions #}
    {% if page.has_math %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/contrib/auto-render.min.js"
        onload="renderMathInElement(document.body, {delimiters: [{left: '$$', right: '$$', display: true}, {left: '$', right: '$', display: false}]})"></script>
    {% endif %}
    {{ json_ld() }}
</head>

<body data-heading-anchor-style="{{ theme.heading_anchor_style }}">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header>
        <nav>
            <a href="{{ url('/') }}" class="site-title"><svg width="28" height="28" viewBox="0 0 24 24" fill="none"
                    xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" stroke="#c68a3e" stroke-width="1.4" />
                    <path d="M12 5 L14 12 L12 19 L10 12 Z" stroke="#4fb3ac" stroke-width="1.4"
                        stroke-linecap="round" />
                </svg>{{ site.name }}</a>
            {# Revealed by js/nav-menu.js only. Without JavaScript it stays
               hidden and the link list wraps instead of collapsing, so the
               menu never depends on a click that cannot happen. #}
            <button id="nav-menu-toggle" class="nav-menu-toggle" type="button"
                    aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path class="nav-menu-bars" d="M4 7h16M4 12h16M4 17h16" />
                    <path class="nav-menu-close" d="M6 6l12 12M18 6L6 18" />
                </svg>
            </button>
            <ul id="nav-menu">
                {# Top-level pages only. Depth is measured against url('/')
                   rather than a literal "/" so the menu survives sub-path
                   deployments (site.base_path): with a prefix, every page
                   URL is one segment deeper and the home URL is the
                   prefixed root, not "/". #}
                {% set home_url = url('/') %}
                {% set nav_depth = home_url | split("/") | list | length %}
                {% for p in pages %}
                {% set p_parts = p.url | split("/") | list %}
                {% if p_parts | length <= nav_depth %} <li><a href="{{ p.url | safe }}" {% if p.url != home_url and page.url is
                        startingwith(p.url) %} class="active" {% elif p.url==page.url %} class="active" {% endif
                        %}>{{ p.nav_title or p.title }}</a></li>
                    {% endif %}
                    {% endfor %}
            </ul>
            {% include "partials/language-switcher.html.jinja" %}
            <div class="nav-tools">
                {% include "partials/version-dropdown.html.jinja" %}
                <button id="search-trigger" class="search-trigger" aria-label="Search" aria-expanded="false" aria-controls="search-overlay" aria-keyshortcuts="/">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                </button>
                <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
                    <span class="theme-toggle-light">&#9790;</span>
                    <span class="theme-toggle-dark">&#9788;</span>
                </button>
            </div>
        </nav>
    </header>

    <main id="main-content">
        {% block content %}{% endblock %}
    </main>

    <footer>
        <span>&copy; 2025-2026 yqr Authors</span>
        <span class="footer-sep" aria-hidden="true">&middot;</span>
        <span><a href="https://github.com/zoosky/yqr">github.com/zoosky/yqr</a></span>
        <span class="footer-sep" aria-hidden="true">&middot;</span>
        <span>Powered by <a href="https://accentcms.dev">Accent CMS</a> {{ accent.version_string }}</span>
        {% if site.last_modified %}
        <span class="footer-sep" aria-hidden="true">&middot;</span>
        <span>Site last updated: {{ site.last_modified }}</span>
        {% endif %}
    </footer>

    {# Search overlay — opened by the trigger button or the "/" shortcut #}
    <div id="search-overlay" hidden role="dialog" aria-modal="true" aria-label="Search">
        <div id="search-overlay-backdrop"></div>
        <div id="search-overlay-card">
            {{ search_form("Search docs…") }}
        </div>
    </div>

    {% for js in theme.assets.js %}
    <script src="{{ url('/theme/assets/' ~ js) }}"></script>
    {% endfor %}
    {# Feature f164: click-to-copy handler is only loaded when the
       heading_anchor_style preset needs it. Keeps pure-CSS presets
       (`hash`, `pilcrow`, `gutter`) JS-free. #}
    {% if theme.heading_anchor_style == "copy" %}
    <script src="{{ url('/theme/assets/js/heading-anchor-copy.js') }}" defer></script>
    {% endif %}
    {% if page.islands is defined and page.islands | length > 0 %}
    {% for island in page.islands %}
    {% if island.source == "plugin" %}
    <script src="{{ url('/assets/plugins/' ~ island.plugin ~ '/' ~ island.js_path) }}" defer></script>
    {% else %}
    <script src="{{ url('/' ~ (('theme/assets/js/islands/' ~ island.component ~ '.js') | fingerprint)) }}" defer></script>
    {% endif %}
    {% endfor %}
    {% endif %}
    <script>
        (function () {
            var d = document.documentElement, s = localStorage.getItem('theme');
            if (s) d.setAttribute('data-theme', s);
            else if (window.matchMedia('(prefers-color-scheme:dark)').matches) d.setAttribute('data-theme', 'dark');
            var btn = document.querySelector('.theme-toggle');
            if (btn) btn.addEventListener('click', function () {
                var cur = d.getAttribute('data-theme');
                var next = cur === 'dark' ? 'light' : 'dark';
                d.setAttribute('data-theme', next);
                localStorage.setItem('theme', next);
            });
        })();
    </script>
    {# Feature f161e: Mermaid client-side loader (dev mode only). #}
    {% include "partials/mermaid-loader.html.jinja" %}
</body>

</html>
