{# Home page template: the hand-authored "yqr in Kubernetes" design from the
   original standalone docs/content/home.html, ported to a real CMS page so
   `accent serve` and `accent build` render the same site (serve/build
   parity). The page body lives in content/index.md (frontmatter
   `template: home`, `process.markdown: false` so the HTML passes through
   untouched); this template carries the page's bespoke stylesheet and hands
   the theme its header menu and footer.

   The page follows the theme's color-mode mechanism: the ink palette is the
   dark mode (the original design), and a paper "daylight" palette drives
   light mode. All mode-dependent values live in the token blocks below --
   `:root` holds daylight, `[data-theme="dark"]` and the no-preference media
   query hold ink -- so the header's theme toggle re-skins the whole page,
   and the theme chrome (header, footer, search) keeps its own light/dark
   styling with proper contrast. #}
{% extends "base.html.jinja" %}

{% block content %}
<style>
{% raw %}
  /* Daylight (light mode): the home page's paper palette. The token NAMES
     keep the original ink-design vocabulary (--ink is "page background",
     --panel is "raised card", --paper is "inverted card") so the rules
     below stay identical across modes. */
  :root{
    --ink:#f2ecda;
    --ink-2:#e9e1c9;
    --panel:#f8f4e9;
    --paper:#fbf8ef;
    --paper-line:#d9cda6;
    --brass:#c68a3e;
    --brass-soft:#8a5f22;
    --route:#22706a;
    --route-soft:#2c6b67;
    --text:#332b1c;
    --text-soft:#5a4c33;
    --text-faint:#8a7a5e;
    --mark:#c1443c;
    --ok:#3e7d55;
    --heading:#2b2415;
    --tok-key:#3d5a78;
    --tok-str:#6b5a2a;
    --badge-drift:#a13830;
    --line:rgba(51,43,28,0.14);
    --serif: Georgia, 'Iowan Old Style', 'Times New Roman', serif;
    --sans: -apple-system, 'Segoe UI', Roboto, system-ui, sans-serif;
    --mono: 'JetBrains Mono', 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  /* Ink (dark mode): the original hand-authored palette, verbatim. */
  [data-theme="dark"]{
    --ink:#0b1524;
    --ink-2:#0f1d33;
    --panel:#132340;
    --paper:#f2ecda;
    --paper-line:#ddd3b2;
    --brass-soft:#e0b169;
    --route:#4fb3ac;
    --text:#dbe4f0;
    --text-soft:#8ea0b8;
    --text-faint:#5c6d84;
    --ok:#5fae7a;
    --heading:#f4efe1;
    --tok-key:#a9c3e0;
    --tok-str:#e8dcb8;
    --badge-drift:#e08d86;
    --line:rgba(255,255,255,0.07);
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme]){
      --ink:#0b1524;
      --ink-2:#0f1d33;
      --panel:#132340;
      --paper:#f2ecda;
      --paper-line:#ddd3b2;
      --brass-soft:#e0b169;
      --route:#4fb3ac;
      --text:#dbe4f0;
      --text-soft:#8ea0b8;
      --text-faint:#5c6d84;
      --ok:#5fae7a;
      --heading:#f4efe1;
      --tok-key:#a9c3e0;
      --tok-str:#e8dcb8;
      --badge-drift:#e08d86;
      --line:rgba(255,255,255,0.07);
    }
  }
  body::before{
    content:"";
    position:fixed;
    inset:0;
    background:
      radial-gradient(ellipse 900px 500px at 12% -10%, rgba(198,138,62,0.10), transparent 60%),
      radial-gradient(ellipse 800px 600px at 100% 10%, rgba(79,179,172,0.08), transparent 60%);
    pointer-events:none;
    z-index:0;
  }
  .wrap{
    position:relative;
    z-index:1;
    max-width:980px;
    margin:0 auto;
    padding:0 24px 96px;
  }
  .wrap a{color:var(--brass-soft);text-decoration-color:rgba(198,138,62,0.4);}
  .wrap a:hover{text-decoration-color:var(--brass-soft);}
  .wrap a:focus-visible, .wrap button:focus-visible{
    outline:2px solid var(--route);
    outline-offset:2px;
  }
  .wrap code, .wrap pre, .wrap .mono{font-family:var(--mono);}

  /* ---------- hero ---------- */
  .hero{padding:22px 0 8px;}
  .hero h1{
    font-family:var(--serif);
    font-weight:400;
    font-size:clamp(34px, 5vw, 52px);
    line-height:1.12;
    margin:0 0 12px;
    color:var(--heading);
    max-width:16ch;
  }
  /* The line that used to be the h1. It keeps the display voice while the
     heading above it carries the plain description of what yqr does. */
  .hero .hero-lede{
    font-family:var(--serif);
    font-size:clamp(19px, 2.2vw, 24px);
    line-height:1.35;
    color:var(--brass-soft);
    max-width:34ch;
    margin:0 0 18px;
  }
  .hero p{
    font-size:17px;
    color:var(--text-soft);
    max-width:56ch;
    margin:0 0 8px;
  }
  .hero code{
    background:rgba(198,138,62,0.14);
    color:var(--brass-soft);
    padding:0.1em 0.4em;
    border-radius:3px;
    font-size:0.92em;
  }

  /* ---------- chart (signature element) ---------- */
  .chart{
    margin:44px 0 20px;
    display:grid;
    grid-template-columns:auto 96px minmax(0,1fr);
    align-items:center;
    gap:0;
  }
  .chart-label{
    padding-right:6px;
  }
  .chart-label .eyebrow{
    display:block;
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:0.12em;
    text-transform:uppercase;
    color:var(--text-faint);
    margin-bottom:6px;
  }
  .chart-label code{
    display:inline-block;
    font-size:14px;
    color:var(--route);
    background:rgba(79,179,172,0.10);
    border:1px solid rgba(79,179,172,0.35);
    border-radius:4px;
    padding:6px 10px;
    white-space:nowrap;
  }
  .chart-route{width:96px;height:36px;overflow:visible;}
  .chart-route-path{
    fill:none;
    stroke:var(--route-soft);
    stroke-width:1.6;
    stroke-dasharray:5 5;
    stroke-dashoffset:120;
    animation:draw 1.1s ease-out 0.2s forwards;
  }
  .chart-route-dot{
    fill:var(--mark);
    opacity:0;
    animation:appear 0.4s ease-out 1.1s forwards;
  }
  @keyframes draw{ to{ stroke-dashoffset:0; } }
  @keyframes appear{ to{ opacity:1; } }
  @media (prefers-reduced-motion:reduce){
    .chart-route-path{animation:none; stroke-dashoffset:0;}
    .chart-route-dot{animation:none; opacity:1;}
  }
  .chart-yaml{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:8px;
    padding:16px 18px;
    font-size:13.5px;
    overflow-x:auto;
    margin:0;
    color:var(--text-soft);
  }
  .chart-yaml .tok-key{color:var(--tok-key);}
  .chart-yaml .tok-str{color:var(--tok-str);}
  .chart-yaml .hit{
    display:inline-block;
    width:100%;
    background:rgba(193,68,60,0.14);
    border-left:2px solid var(--mark);
    padding-left:8px;
    margin-left:-10px;
  }
  .chart-yaml .hit .tok-val{color:var(--brass-soft); font-weight:600;}

  @media (max-width:640px){
    .chart{grid-template-columns:1fr;}
    .chart-route{display:none;}
    .chart-label{margin-bottom:10px;}
  }

  /* ---------- terminal / outcome strip ---------- */
  .outcomes{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
    margin:0 0 56px;
  }
  @media (max-width:640px){ .outcomes{grid-template-columns:1fr;} }
  .outcome{
    background:var(--ink-2);
    border:1px solid var(--line);
    border-radius:8px;
    padding:16px 18px;
  }
  .outcome .badge{
    font-family:var(--mono);
    font-size:10.5px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    padding:2px 8px;
    border-radius:999px;
    display:inline-block;
    margin-bottom:10px;
  }
  .outcome.drift .badge{background:rgba(193,68,60,0.18); color:var(--badge-drift);}
  .outcome.exact .badge{background:rgba(95,174,122,0.18); color:var(--ok);}
  .outcome pre{
    margin:0;
    font-size:13px;
    white-space:pre-wrap;
    word-break:break-word;
    color:var(--text);
  }
  .outcome pre .prompt{color:var(--text-faint);}
  .outcome pre .out{color:var(--brass-soft); font-weight:600;}

  /* ---------- sections ---------- */
  .wrap section{margin:64px 0;}
  .section-head{margin-bottom:22px;}
  .section-head .eyebrow{
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:0.12em;
    text-transform:uppercase;
    color:var(--text-faint);
    margin:0 0 8px;
  }
  .wrap h2{
    font-family:var(--serif);
    font-weight:400;
    font-size:26px;
    margin:0 0 6px;
    color:var(--heading);
  }
  .section-head p{color:var(--text-soft); margin:6px 0 0; max-width:60ch;}

  /* ---------- installed paths ---------- */
  .paths{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px;
  }
  @media (max-width:640px){ .paths{grid-template-columns:1fr;} }
  .path-card{
    background:var(--paper);
    color:#332b1c;
    border-radius:8px;
    padding:20px 22px;
    border:1px solid var(--paper-line);
  }
  .path-card h3{
    font-family:var(--sans);
    font-size:13px;
    letter-spacing:0.06em;
    text-transform:uppercase;
    margin:0 0 12px;
    color:#6b4a1f;
  }
  .path-card code.loc{
    display:block;
    background:rgba(51,43,28,0.06);
    border:1px solid rgba(51,43,28,0.12);
    border-radius:4px;
    padding:8px 10px;
    font-size:13px;
    margin:8px 0;
    color:#332b1c;
  }
  .path-card p{font-size:14px; margin:10px 0 0; color:#5a4c33;}

  .callout{
    margin-top:18px;
    background:var(--ink-2);
    border-left:3px solid var(--brass);
    border-radius:0 8px 8px 0;
    padding:14px 18px;
    font-size:14px;
    color:var(--text-soft);
  }
  .callout .callout-title{color:var(--heading);}
  .callout code{color:var(--brass-soft);}
  .callout pre{
    margin:10px 0 0;
    font-size:12.5px;
    color:var(--text-faint);
    white-space:pre-wrap;
  }

  /* ---------- recipe cards ---------- */
  .cards{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
  }
  @media (max-width:720px){ .cards{grid-template-columns:1fr;} }
  .card{
    min-width:0;
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:10px;
    padding:22px 24px;
  }
  .card h3{
    font-family:var(--serif);
    font-size:19px;
    font-weight:400;
    margin:0 0 8px;
    color:var(--heading);
  }
  .card > p{font-size:14px; color:var(--text-soft); margin:0 0 16px;}
  .recipe{margin:0 0 16px;}
  .recipe:last-child{margin-bottom:0;}
  .recipe .cmd{
    display:block;
    background:var(--ink-2);
    border:1px solid var(--line);
    border-radius:6px;
    padding:10px 12px;
    font-size:12.5px;
    overflow-x:auto;
    color:var(--text);
    margin:0 0 6px;
    white-space:pre-wrap;
    overflow-wrap:break-word;
  }
  .recipe .cmd .prompt{color:var(--text-faint);}
  .recipe .cmd .filter{color:var(--route);}
  .recipe .note{font-size:13px; color:var(--text-faint); margin:0;}

  .dockerfile{
    background:var(--ink-2);
    border:1px solid var(--line);
    border-radius:6px;
    padding:14px 16px;
    font-size:12.5px;
    overflow-x:auto;
    color:var(--text);
    margin:0 0 14px;
    white-space:pre-wrap;
    overflow-wrap:break-word;
  }
  .dockerfile .rem{color:var(--text-faint);}
  .dockerfile .kw{color:var(--tok-key);}

  /* ---------- beyond-kubernetes trio ---------- */
  .trio{
    display:grid;
    grid-template-columns:1fr 1fr 1fr;
    gap:16px;
  }
  @media (max-width:860px){ .trio{grid-template-columns:1fr;} }
  .mini-card{
    min-width:0;
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:10px;
    padding:18px 20px;
  }
  .mini-card h3{
    font-family:var(--serif);
    font-size:17px;
    font-weight:400;
    margin:0 0 6px;
    color:var(--heading);
  }
  .mini-card > p{font-size:13px; color:var(--text-soft); margin:0 0 14px;}
  .mini-card .recipe{margin:0 0 12px;}
  .mini-card .recipe .cmd{
    font-size:11.5px;
    padding:8px 10px;
  }
  .mini-card .recipe .note{font-size:12px;}

  /* ---------- further-afield stack ---------- */
  .explicit-card{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:10px;
    padding:24px 26px;
    margin-bottom:20px;
  }
  .explicit-card:last-child{margin-bottom:0;}
  .explicit-card h3{
    font-family:var(--serif);
    font-size:19px;
    font-weight:400;
    margin:0 0 8px;
    color:var(--heading);
  }
  .explicit-card > p.lede{font-size:14px; color:var(--text-soft); margin:0 0 16px; max-width:64ch;}
  .snippet{
    background:var(--ink-2);
    border:1px solid var(--line);
    border-radius:6px;
    padding:12px 16px;
    font-size:12.5px;
    overflow-x:auto;
    color:var(--text-soft);
    margin:0 0 18px;
  }
  .snippet .tok-key{color:var(--tok-key);}
  .explicit-recipes{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
  }
  @media (max-width:700px){ .explicit-recipes{grid-template-columns:1fr;} }
  .explicit-recipes .recipe{min-width:0;}
  .explicit-recipes .recipe .note{font-size:13.5px; color:var(--text-soft); line-height:1.55;}
  .snippet, .snippet code{white-space:pre-wrap; overflow-wrap:break-word;}

  /* ---------- filter grammar table ---------- */
  .wrap table{
    width:100%;
    border-collapse:collapse;
    font-size:14px;
  }
  .wrap th, .wrap td{
    text-align:left;
    padding:10px 14px;
    border-bottom:1px solid var(--line);
  }
  .wrap th{
    font-family:var(--mono);
    font-size:11px;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--text-faint);
    font-weight:400;
  }
  .wrap td code{color:var(--route);}
  .wrap td.meaning{color:var(--text-soft);}
  .not-yet{
    margin-top:14px;
    font-size:13px;
    color:var(--text-faint);
  }
  .not-yet code{color:var(--text-faint);}
{% endraw %}
</style>

<div class="wrap">
{{ page.content | safe }}
</div>

{# Structured data for the tool itself. accent's json_ld() already emits a
   WebSite node describing the *site*; this describes the *software*, which is
   the entity search engines can actually present richly for a developer tool.
   JSON-LD is valid in the body, so this needs no change to the vendored base
   template. Keep `softwareVersion` in step with Cargo.toml on release. #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "yqr",
  "applicationCategory": "DeveloperApplication",
  "applicationSubCategory": "Command Line Utility",
  "operatingSystem": "Linux, macOS, Windows",
  "softwareVersion": "0.5.1",
  "description": "A jq-style query and editing tool for YAML. Reads are byte-preserving by default; edits change only the targeted bytes, leaving comments, anchors, quote style and blank lines intact.",
  "url": "https://zoosky.github.io/yqr/",
  "codeRepository": "https://github.com/zoosky/yqr",
  "programmingLanguage": "Rust",
  "license": "MIT OR Apache-2.0",
  "isAccessibleForFree": true,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
}
</script>
{% endblock %}
